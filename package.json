{
  "name": "2d-map-borouge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.borouge.map3d",
    "productName": "2D Map Borouge",
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  }
}
